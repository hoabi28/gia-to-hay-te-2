# Domain thật khi deploy (dùng cho sitemap, robots.txt, canonical URL, OpenGraph).
# Không đặt dấu "/" ở cuối. Bỏ trống khi chạy local (mặc định http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://giatothayte.com

# Connection string Postgres (Prisma Postgres, Neon, hoặc bất kỳ Postgres nào khác).
DATABASE_URL="postgres://user:pass@host:5432/db?sslmode=require"

# Mật khẩu đăng nhập trang quản trị /admin.
ADMIN_PASSWORD="doi-mat-khau-nay"

# Chuỗi ngẫu nhiên để ký cookie phiên đăng nhập admin. Có thể tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="doi-chuoi-nay-thanh-ngau-nhien"
